{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__(plugin_management-portal_)?management-portal__(create|update|add|complete|insert|reorder|set|delete|promote|attach|approve|reject|log|start|stop|send|react|edit|resolve|remember|register|require|release)_.*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/scripts/portal-gate.js\" pre",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__(plugin_management-portal_)?management-portal__(create|update|add|complete|insert|reorder|set|delete|promote|attach|approve|reject|log|start|stop|send|react|edit|resolve|remember|register|require|release)_.*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/scripts/portal-gate.js\" post",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "mcp__(plugin_management-portal_)?management-portal__(await_my_turn|start_watching_channel)",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/scripts/watch-alarm.js\" record",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/scripts/watch-alarm.js\" preflight",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/scripts/watch-alarm.js\" check",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
